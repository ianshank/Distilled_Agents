{
  "product-sdlc-allowlist": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/pre_tool_use.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "product-sdlc-stop": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/stop_gate.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
