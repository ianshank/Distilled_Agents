# Copy to .env for local overrides. Never commit .env.

# AWS / SageMaker
AWS_REGION=us-east-1
MANGOMAS_AWS_REGION=us-east-1
MANGOMAS_EXECUTION_ROLE_NAME=mangomas-sagemaker-sagemaker-execution-role
MANGOMAS_S3_BUCKET_PREFIX=mangomas-sagemaker-production
MANGOMAS_TRAINING_DATA_BUCKET=mangomas-training-data
MANGOMAS_GPU_INSTANCE_TYPE=ml.g4dn.xlarge
MANGOMAS_CPU_INSTANCE_TYPE=ml.m5.large
MANGOMAS_MAX_RUN_SECONDS=7200

# Models
MANGOMAS_TEACHER_MODEL=mistralai/Mistral-7B-v0.1
MANGOMAS_STUDENT_MODEL=microsoft/DialoGPT-medium
MANGOMAS_CPU_MODEL=distilbert-base-uncased
MANGOMAS_TRUST_REMOTE_CODE=false

# Local inference
MANGOMAS_BIND_HOST=127.0.0.1
PORT=8080
MODEL_DIR=/opt/ml/model

# Enhanced system
ENHANCED_SYSTEM_ENV=development
REDIS_HOST=localhost
REDIS_PORT=6379

# Agent harness (local runtime; omitted YAML fields inherit these)
MANGOMAS_HARNESS_ID=
MANGOMAS_HARNESS_DIR=
MANGOMAS_HARNESS_MAX_STEPS=8
MANGOMAS_HARNESS_MEMORY_WINDOW=6
MANGOMAS_HARNESS_SAG_SAMPLES=1
MANGOMAS_HARNESS_SAG_TEMPERATURE=0.0
MANGOMAS_HARNESS_MAX_LENGTH=512
MANGOMAS_HARNESS_SEED=0
MANGOMAS_TRAJECTORY_DISTILL_ALPHA=0.0
MANGOMAS_HARNESS_APPLY_PATCHES=false

# Compose secrets (do not use defaults in production)
GF_SECURITY_ADMIN_PASSWORD=
